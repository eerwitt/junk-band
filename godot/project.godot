config_version=5

[application]
config/name="JUNK — The Living Sampler"
run/main_scene="res://scenes/studio.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A living sampler. Cut it. Hear it. Make it dance."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="disabled"
window/size/min_width=360
window/size/min_height=640

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.9686, 0.9608, 0.9255, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
