# Browser build: public gateway URL, including /api. Default: same-origin /api.
# JUNK_API_BASE=https://your-modal-gateway.modal.run/api

# Copy this file to .env. Restart the gateway after changing server settings.
# auto uses real providers as soon as credentials are present; no silent mock fallback.
JUNK_MODE=auto
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173
JUNK_DATA_DIR=data
# MODEL_API_KEY=
# Muse Image uses the segmented object as a reference, then SAM removes its background.
META_IMAGE_MODEL=muse-image-1.0
# Local gateway -> deployed Modal Separator, with automatic media-volume staging.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Or JUNK_MODAL_ENABLED=true to use an existing Modal CLI login.
JUNK_MODAL_APP=junk-living-sampler
JUNK_MODAL_VOLUME=junk-session-media
# HF_TOKEN is needed by the deployed GPU worker, not by the browser.
# HF_TOKEN=
# JUNK_API_SESSION_SECRET=32-or-more-random-characters
# Requests across the whole site per day. One new object is about three.
# JUNK_DAILY_REQUEST_LIMIT=90
# New work stops once this month's Modal usage reaches this, or anything is actually charged.
# JUNK_MODAL_MONTHLY_LIMIT=20
# New work stops once this site's Meta spend this month reaches this, added up per call.
# JUNK_META_MONTHLY_LIMIT=100
SAM_AUDIO_MODEL_ID=facebook/sam-audio-small-tv
SAM_AUDIO_GPU=L40S
SAM_AUDIO_PREDICT_SPANS=true
SAM_AUDIO_RERANKING_CANDIDATES=8
# Freeze to verified source and checkpoint revisions after first remote smoke.
SAM_AUDIO_REVISION=bb4c6999d2677c7402360e426afc01ddfad6dce0
SAM_AUDIO_MODEL_REVISION=afc58d67609fee0086b9c032d91b7db8ebec1aa7
